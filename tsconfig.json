{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["firefox-webext-browser", "bun"]
  },
  "include": ["extension/src/**/*.ts", "scripts/*.ts"]
}
